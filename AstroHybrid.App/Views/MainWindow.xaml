<Window x:Class="AstroHybrid.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:AstroHybrid.App.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AstroHybrid.App.Views"
        xmlns:app="clr-namespace:AstroHybrid.App"
        xmlns:vm="clr-namespace:AstroHybrid.App.ViewModels"
        xmlns:models="clr-namespace:AstroHybrid.App.Models"
        mc:Ignorable="d"
        Title="{svc:Tr 'AstroHybrid'}" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        MinHeight="600" MinWidth="900"
        Style="{StaticResource MainWindowStyle}"
        Icon="/Resources/akibot.ico">


    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <app:UpdateStateToVisibilityConverter x:Key="UpdateStateToVisibilityConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                Width="240">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Border Grid.Row="0" Padding="20,20,20,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Resources/akibot.png" Width="40" Height="40"/>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{svc:Tr 'AstroHybrid'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{svc:Tr 'Astro Bot PC Port'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <StackPanel Grid.Row="1" Margin="10,20,10,0">
                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Home}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Home">
                        <RadioButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏠" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="{svc:Tr 'Home'}"/>
                            </StackPanel>
                        </RadioButton.Content>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=GraphicsSettings}"
                                 Command="{Binding NavigateCommand}" CommandParameter="GraphicsSettings"
                                 Margin="0,4,0,0">
                        <RadioButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎮" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="{svc:Tr 'Graphics'}"/>
                            </StackPanel>
                        </RadioButton.Content>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ControllerSettings}"
                                 Command="{Binding NavigateCommand}" CommandParameter="ControllerSettings"
                                 Margin="0,4,0,0">
                        <RadioButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎯" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="{svc:Tr 'Controller'}"/>
                            </StackPanel>
                        </RadioButton.Content>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=AdvancedSettings}"
                                 Command="{Binding NavigateCommand}" CommandParameter="AdvancedSettings"
                                 Margin="0,4,0,0">
                        <RadioButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="{svc:Tr 'Advanced'}"/>
                            </StackPanel>
                        </RadioButton.Content>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Installation}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Installation"
                                 Margin="0,4,0,0">
                        <RadioButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="{svc:Tr 'Installation'}"/>
                            </StackPanel>
                        </RadioButton.Content>
                    </RadioButton>
                </StackPanel>

                <!-- Status Bar -->
                <Border Grid.Row="2" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="{svc:Tr 'STATUS'}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
                        <ProgressBar Value="{Binding IsLoading, Converter={StaticResource BoolToProgressConverter}}"
                                     Maximum="1" IsIndeterminate="{Binding IsLoading}"
                                     Style="{StaticResource ModernProgressBarStyle}" Height="4" Margin="0,8,0,0"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Page Content -->
                <ContentControl Grid.Row="0" Content="{Binding CurrentPage, Converter={StaticResource PageTemplateSelector}}"
                                Margin="30,30,30,0"/>

                <!-- Update Notification Banner -->
                <Border Grid.Row="0" VerticalAlignment="Top" Margin="30,30,30,0"
                        Visibility="{Binding ShowUpdateNotification, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="{StaticResource PrimaryBrush}" CornerRadius="8" Padding="20"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔔" FontSize="24" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{svc:Tr 'NEW ASTROHYBRID UPDATE AVAILABLE'}" FontSize="14" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding UpdateState.LatestUpdate.Version, StringFormat='Version {0}'}" FontSize="13" Foreground="#CCFFFFFF" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding UpdateState.LatestUpdate.ReleaseNotes}" FontSize="12" Foreground="#AAFFFFFF" TextWrapping="Wrap" MaxWidth="500" Margin="0,8,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="{svc:Tr 'Update Now'}" Command="{Binding DownloadUpdateCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" MinWidth="120" MinHeight="36"
                                FontSize="13" FontWeight="SemiBold" Margin="16,0,8,0"
                                Visibility="{Binding UpdateState.IsDownloading, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <Button Grid.Column="2" Content="{svc:Tr 'Downloading...'}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="120" MinHeight="36"
                                FontSize="13" FontWeight="SemiBold" Margin="16,0,8,0" IsEnabled="False"
                                Visibility="{Binding UpdateState.IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Grid.Column="3" Content="{svc:Tr 'Ignore for Now'}" Command="{Binding IgnoreUpdateCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" MinWidth="110" MinHeight="36"
                                FontSize="13" Margin="8,0,0,0"
                                Visibility="{Binding UpdateState.IsDownloading, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <Button Grid.Column="3" Content="{svc:Tr 'Cancel'}" Command="{Binding DismissUpdateNotificationCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" MinWidth="80" MinHeight="36"
                                FontSize="13" Margin="8,0,0,0"
                                Visibility="{Binding UpdateState.IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <!-- Bottom Action Bar -->
                <Border Grid.Row="1" Padding="30,20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="{svc:Tr 'Best Settings for This PC'}" Command="{Binding ApplyBestSettingsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"
                                    Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=GraphicsSettings}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- Update button shown when update is available and not downloading/installing -->
                            <Button Content="{svc:Tr 'Update'}" Command="{Binding DownloadUpdateCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" MinWidth="120" MinHeight="48"
                                    FontSize="16" FontWeight="SemiBold" Margin="0,0,10,0"
                                    Visibility="{Binding UpdateState.UpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    IsEnabled="{Binding UpdateState.UpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Content="{svc:Tr 'Play'}" Command="{Binding LaunchGameCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" MinWidth="140" MinHeight="48"
                                    FontSize="16" FontWeight="SemiBold"
                                    IsEnabled="{Binding InstallationState.IsInstalled}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>