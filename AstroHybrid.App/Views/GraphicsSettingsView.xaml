<UserControl x:Class="AstroHybrid.App.Views.GraphicsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:AstroHybrid.App.Services"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AstroHybrid.App.Views"
             xmlns:vm="clr-namespace:AstroHybrid.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,20">
            <!-- Resolution & Display -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{svc:Tr 'Display'}" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource BodyTextStyle}" Text="{svc:Tr 'Resolution'}" VerticalAlignment="Center" Width="150"/>
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding ResolutionLabels}"
                                  SelectedIndex="{Binding ResolutionIndex}"
                                  Style="{StaticResource ModernComboBoxStyle}" Width="300"/>

                        <CheckBox Grid.Row="1" Grid.Column="1" Content="{svc:Tr 'Start in fullscreen'}"
                                   IsChecked="{Binding Fullscreen}"
                                   Style="{StaticResource ModernCheckBoxStyle}"
                                   VerticalAlignment="Center" Margin="0,10,0,0"/>

                        <CheckBox Grid.Row="2" Grid.Column="1" Content="{svc:Tr 'Ultrawide 21:9 rendering'}"
                                   IsChecked="{Binding Ultrawide}"
                                   Style="{StaticResource ModernCheckBoxStyle}"
                                   VerticalAlignment="Center" Margin="0,10,0,0"/>
                    </Grid>
                    <TextBlock Text="{Binding UltrawideNote}" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                    <!-- Graphics card (issue #24): integrated and discrete adapters can be chosen. -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource BodyTextStyle}" Text="{svc:Tr 'Graphics card'}" VerticalAlignment="Center" Width="150"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding GpuLabels}"
                                  SelectedIndex="{Binding GpuIndex}"
                                  IsEnabled="{Binding HasGpuChoice}"
                                  Style="{StaticResource ModernComboBoxStyle}" Width="400"/>
                    </Grid>
                    <TextBlock Text="{Binding GpuNote}" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                    <CheckBox Content="{svc:Tr 'VSync (no tearing; may add a little input delay)'}"
                              IsChecked="{Binding VSync}"
                              IsEnabled="{Binding IsVSyncAvailable}"
                              Style="{StaticResource ModernCheckBoxStyle}" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding VSyncNote}" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Frame Rate -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{svc:Tr 'Frame Rate'}" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource BodyTextStyle}" Text="{svc:Tr 'Limit'}" VerticalAlignment="Center" Width="150"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding FpsLabels}"
                                  SelectedIndex="{Binding FpsIndex}"
                                  IsEnabled="{Binding IsFpsLimitEnabled}"
                                  Style="{StaticResource ModernComboBoxStyle}" Width="400"/>
                    </Grid>

                    <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding FpsLimitNote}"/>
                </StackPanel>
            </Border>

            <!-- NVIDIA RTX Features -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{svc:Tr 'NVIDIA RTX Features'}" Style="{StaticResource SectionHeaderStyle}"/>

                    <TextBlock Text="{Binding HardwareNote}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,15" TextWrapping="Wrap"/>

                    <!-- Ray Tracing (OFF / ON) -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource BodyTextStyle}" Text="{svc:Tr 'Ray Tracing (RTX)'}" VerticalAlignment="Center" Width="150"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding RayTracingLabels}"
                                  SelectedIndex="{Binding RayTracingIndex}"
                                  Style="{StaticResource ModernComboBoxStyle}" Width="400"/>
                    </Grid>
                    <TextBlock Text="{Binding RayTracingNote}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <!-- Upscaling -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource BodyTextStyle}" Text="{svc:Tr 'Upscaling'}" VerticalAlignment="Center" Width="150"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding UpscaleLabels}"
                                  SelectedIndex="{Binding UpscaleIndex}"
                                  Style="{StaticResource ModernComboBoxStyle}" Width="400"
                                  IsEnabled="{Binding SupportsDlss}"/>
                    </Grid>

                    <!-- Frame Generation -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource BodyTextStyle}" Text="{svc:Tr 'Frame Generation'}" VerticalAlignment="Center" Width="150"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding FrameGenLabels}"
                                  SelectedIndex="{Binding FrameGenIndex}"
                                  Style="{StaticResource ModernComboBoxStyle}" Width="400"
                                  IsEnabled="{Binding IsFrameGenAvailable}"/>
                    </Grid>

                    <!-- Frame Gen Target -->
                    <Grid Margin="0,0,0,10" Visibility="{Binding IsFrameGenTargetEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource BodyTextStyle}" Text="{svc:Tr 'Target FPS'}" VerticalAlignment="Center" Width="150"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding FrameGenTargetLabels}"
                                  SelectedIndex="{Binding FrameGenTargetIndex}"
                                  Style="{StaticResource ModernComboBoxStyle}" Width="400"/>
                    </Grid>

                    <!-- Frame Gen Note -->
                    <TextBlock Text="{Binding FrameGenNote}" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <!-- Reflex -->
                    <CheckBox Content="{svc:Tr 'NVIDIA Low Latency (Reflex)'}" IsChecked="{Binding LowLatency}"
                              Style="{StaticResource ModernCheckBoxStyle}" Margin="0,15,0,0"
                              IsEnabled="{Binding SupportsReflex}"/>
                </StackPanel>
            </Border>

            <!-- Performance Overlay -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{svc:Tr 'Performance Overlay'}" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource BodyTextStyle}" Text="{svc:Tr 'Show Stats'}" VerticalAlignment="Center" Width="150"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding OverlayLabels}"
                                  SelectedIndex="{Binding OverlayIndex}"
                                  Style="{StaticResource ModernComboBoxStyle}" Width="400"/>
                    </Grid>

                    <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" Text="{svc:Tr 'In game: F2 shows/hides overlay, Ctrl+F2 changes frame-rate limit, F11 or Alt+Enter toggles fullscreen.'}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Hardware Summary -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{svc:Tr 'Hardware Summary'}" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Text="{Binding HardwareNote}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
