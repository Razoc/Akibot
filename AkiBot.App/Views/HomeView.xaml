<UserControl x:Class="AkiBot.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:AkiBot.App.Services">

    <Border CornerRadius="18" ClipToBounds="True" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF1F1640" Offset="0"/>
                <GradientStop Color="#FF120E24" Offset="0.55"/>
                <GradientStop Color="#FF0E0B1A" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <!-- Décor : ciel étoilé et planètes (dessin original) -->
            <Canvas IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse Canvas.Left="430" Canvas.Top="-160" Width="620" Height="620">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#557C5CFF" Offset="0"/>
                            <GradientStop Color="#007C5CFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Canvas.Left="620" Canvas.Top="90" Width="230" Height="230">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.3,0.25" Center="0.4,0.35" RadiusX="0.7" RadiusY="0.7">
                            <GradientStop Color="#FFB49BFF" Offset="0"/>
                            <GradientStop Color="#FF6446E6" Offset="0.55"/>
                            <GradientStop Color="#FF2A1D63" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Canvas.Left="575" Canvas.Top="185" Width="320" Height="44" Stroke="#99FF9F43" StrokeThickness="3"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-14"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Canvas.Left="820" Canvas.Top="330" Width="54" Height="54">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.3,0.3">
                            <GradientStop Color="#FFFFC58A" Offset="0"/>
                            <GradientStop Color="#FFFF9F43" Offset="0.6"/>
                            <GradientStop Color="#FFB4581A" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!-- Étoiles -->
                <Ellipse Canvas.Left="80" Canvas.Top="60" Width="3" Height="3" Fill="#CCFFFFFF"/>
                <Ellipse Canvas.Left="210" Canvas.Top="34" Width="2" Height="2" Fill="#99FFFFFF"/>
                <Ellipse Canvas.Left="360" Canvas.Top="96" Width="2" Height="2" Fill="#88FFFFFF"/>
                <Ellipse Canvas.Left="520" Canvas.Top="40" Width="3" Height="3" Fill="#BBFFFFFF"/>
                <Ellipse Canvas.Left="890" Canvas.Top="60" Width="2" Height="2" Fill="#AAFFFFFF"/>
                <Ellipse Canvas.Left="560" Canvas.Top="380" Width="2" Height="2" Fill="#77FFFFFF"/>
                <Ellipse Canvas.Left="700" Canvas.Top="440" Width="3" Height="3" Fill="#99FFFFFF"/>
                <Ellipse Canvas.Left="470" Canvas.Top="250" Width="2" Height="2" Fill="#66FFFFFF"/>
                <Ellipse Canvas.Left="40" Canvas.Top="400" Width="2" Height="2" Fill="#55FFFFFF"/>
                <Path Canvas.Left="540" Canvas.Top="110" Fill="#FFFF9F43" Opacity="0.9"
                      Data="M8,0 L10,6 L16,8 L10,10 L8,16 L6,10 L0,8 L6,6 Z"/>
                <Path Canvas.Left="900" Canvas.Top="250" Fill="#DDFFFFFF"
                      Data="M6,0 L7.5,4.5 L12,6 L7.5,7.5 L6,12 L4.5,7.5 L0,6 L4.5,4.5 Z"/>
                <Path Canvas.Left="300" Canvas.Top="30" Fill="#AAFFFFFF"
                      Data="M5,0 L6,4 L10,5 L6,6 L5,10 L4,6 L0,5 L4,4 Z"/>
            </Canvas>

            <!-- Texte -->
            <StackPanel VerticalAlignment="Bottom" Margin="44,0,44,44">
                <Border HorizontalAlignment="Left" CornerRadius="12" Padding="10,4" Background="#1AFFFFFF" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0"
                                 Fill="{Binding GameStatus, Converter={StaticResource StatusToBrushConverter}}"/>
                        <TextBlock Text="{Binding GameStatus}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="ASTRO BOT" FontSize="64" FontWeight="Black" Foreground="White"/>
                <TextBlock Text="{svc:Tr 'App.Tagline'}" FontSize="17" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,2,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                    <Border CornerRadius="10" Padding="14,9" Background="#33000000" BorderBrush="#26FFFFFF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource PrimaryLightBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding CurrentGraphicsConfig}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                        </StackPanel>
                    </Border>
                    <Button Content="{svc:Tr 'UI.Edit'}" Command="{Binding NavigateToSettingsCommand}" Style="{StaticResource GhostButtonStyle}"
                            Background="#33000000" BorderBrush="#26FFFFFF" Height="38" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
