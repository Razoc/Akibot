 src/graphics/host_gpu/renderer/dlss.h         |   2 +-
 src/graphics/host_gpu/renderer/renderDraw.cpp |  11 +-
 src/graphics/presentation/akibotMenu.cpp      |   4 +-
 4 files changed, 104 insertions(+), 28 deletions(-)

