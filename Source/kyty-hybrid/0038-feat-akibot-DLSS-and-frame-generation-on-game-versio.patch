 		if (const char* value = std::getenv("AKIBOT_DLSS_PASS"); value != nullptr) {
 			s.pass_hash = std::strtoull(value, nullptr, 16);
 		}
+		if (const char* value = std::getenv("AKIBOT_DLSS_PASS_B"); value != nullptr) {
+			s.pass_hash_b = std::strtoull(value, nullptr, 16);
+		}
 		if (const char* value = std::getenv("AKIBOT_DLSS_JITTER_SIGN"); value != nullptr) {
 			s.jitter_sign = std::strtof(value, nullptr) < 0 ? -1.0f : 1.0f;
 		}
@@ -235,6 +242,7 @@ State& Get() {
 			s.quality = std::strcmp(value, "balanced") == 0      ? 1
 			            : std::strcmp(value, "performance") == 0 ? 2
 			            : std::strcmp(value, "dlaa") == 0        ? 3
+			            : std::strcmp(value, "ultra") == 0       ? 4
 			                                                     : 0;
 		}
 		return s;
@@ -279,10 +287,66 @@ bool Fail(State& s, Fallback reason) {
 	return false;
 }
 
+// The game's upscale pass, either layout (dlss.h): sizes, frame, motion-vector and colour images,
+// and the jitter in input pixels. False when this draw is not that pass or its constants are short.
+struct PassInfo {
+	uint32_t in_w = 0, in_h = 0, out_w = 0, out_h = 0, frame = 0;
+	bool     mv_used = false;
+	ImageId  mv {};
+	ImageId  color {};
+	float    jitter_px[2] {};
+};
+
+bool ReadPass(const State& s, const PreparedBindings& pixel, PassInfo& info) {
+	const auto hash = pixel.runtime->program->shader_hash;
+	if ((hash != s.pass_hash && hash != s.pass_hash_b) || pixel.images.size() < 2 ||
+	    pixel.buffer_sources.empty() || pixel.buffer_sources[0].address == 0 ||
+	    pixel.buffer_sources[0].size < 56) {
+		return false;
+	}
+	const auto* cb = reinterpret_cast<const uint32_t*>(pixel.buffer_sources[0].address);
+	if (hash == s.pass_hash) {
+		float jitter_uv[2];
+		std::memcpy(jitter_uv, cb, sizeof(jitter_uv));
+		info.out_w = cb[4], info.out_h = cb[5], info.in_w = cb[6], info.in_h = cb[7], info.frame = cb[11];
+		info.mv_used      = cb[13] != 0;
+		info.mv           = pixel.images[0].image_id;
+		info.color        = pixel.images[1].image_id;
+		info.jitter_px[0] = s.jitter_sign * jitter_uv[0] * static_cast<float>(info.in_w);
+		info.jitter_px[1] = s.jitter_sign * jitter_uv[1] * static_cast<float>(info.in_h);
+		return true;
+	}
+	// Layout B: colour, motion vectors (a G-buffer target, found by its depth attachment) and history.
+	info.out_w = cb[0], info.out_h = cb[1], info.in_w = cb[2], info.in_h = cb[3], info.frame = cb[7];
+	info.mv_used = cb[9] != 0;
+	const auto has_depth = [&](ImageId id) {
+		for (const auto& pair: s.depth_pairs) {
+			if (pair.color == id && pair.depth) {
+				return true;
+			}
+		}
+		return false;
+	};
+	for (size_t i = 0; i < pixel.images.size() && i < 3; ++i) {
+		if (!info.mv && has_depth(pixel.images[i].image_id)) {
+			info.mv = pixel.images[i].image_id;
+		}
+	}
+	for (size_t i = 0; i < pixel.images.size() && i < 2; ++i) {
+		if (pixel.images[i].image_id != info.mv && !info.color) {
+			info.color = pixel.images[i].image_id;
+		}
+	}
+	info.jitter_px[0] = s.jitter_sign * s.camera_jitter[0] * 0.5f * static_cast<float>(info.in_w);
+	info.jitter_px[1] = -s.jitter_sign * s.camera_jitter[1] * 0.5f * static_cast<float>(info.in_h);
+	return static_cast<bool>(info.mv) && static_cast<bool>(info.color);
+}
+
 } // namespace
 
 void RenderExecutor::NoteFrameGenCamera(const PreparedBindings& stage) {
-	if (!FrameGen::CameraWanted()) {
