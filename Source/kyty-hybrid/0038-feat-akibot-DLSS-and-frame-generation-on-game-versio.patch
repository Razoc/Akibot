@@ -297,7 +361,14 @@ void RenderExecutor::NoteFrameGenCamera(const PreparedBindings& stage) {
 		    !zero(m[4]) || !zero(m[15]) || std::fabs(std::fabs(m[11]) - 1.0f) > 1e-5f) {
 			continue;
 		}
-		FrameGen::SetCamera(m);
+		// The jittered projection carries the sub-pixel offset in its third column (layout B's jitter).
+		if (std::fabs(m[8]) > 1e-7f || std::fabs(m[9]) > 1e-7f) {
+			Get().camera_jitter[0] = m[8];
+			Get().camera_jitter[1] = m[9];
+		}
+		if (camera_wanted) {
+			FrameGen::SetCamera(m);
+		}
 		return;
 	}
 }
