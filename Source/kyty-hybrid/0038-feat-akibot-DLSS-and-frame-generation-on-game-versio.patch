 	for (const auto& pair: s.depth_pairs) {
 		if (pair.color == mv_id) {
@@ -407,7 +477,8 @@ bool RenderExecutor::TryDlssUpscale(CommandBuffer& buffer, PreparedBindings& pix
 		return false;
 	}
 	auto& s = Get();
-	if (pixel.runtime->program->shader_hash != s.pass_hash) {
+	const auto hash = pixel.runtime->program->shader_hash;
+	if (hash != s.pass_hash && hash != s.pass_hash_b) {
