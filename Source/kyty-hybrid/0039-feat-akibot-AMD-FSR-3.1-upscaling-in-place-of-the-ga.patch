+#if KYTY_FFX
+// FSR asks the device for its Vulkan functions through this: logs the ones the device does not give.
+PFN_vkGetDeviceProcAddr g_fsr_real_gdpa = nullptr;
+PFN_vkVoidFunction VKAPI_PTR FsrGetDeviceProcAddr(VkDevice device, const char* name) {
+	auto fn = g_fsr_real_gdpa != nullptr ? g_fsr_real_gdpa(device, name) : nullptr;
+	// FSR asks for some core Vulkan 1.1+ functions by their old extension name (…KHR) and calls them
+	// without checking: give it the core function when the extension name is not enabled.
+	if (fn == nullptr && g_fsr_real_gdpa != nullptr) {
+		const size_t length = std::strlen(name);
+		if (length > 3 && std::strcmp(name + length - 3, "KHR") == 0) {
+			const std::string core(name, length - 3);
+			fn = g_fsr_real_gdpa(device, core.c_str());
+		}
+	}
+	if (fn == nullptr) {
+		std::printf("FSR: device function missing: %s\n", name);
+		std::fflush(stdout);
+	}
+	return fn;
+}
+#endif
