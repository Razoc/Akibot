+bool RenderExecutor::TryFsrUpscale(CommandBuffer& buffer, PreparedBindings& pixel, ImageId output) {
+	auto&      s    = Get();
+	const auto hash = pixel.runtime->program->shader_hash;
+	if (hash != s.pass_hash && hash != s.pass_hash_b) {
+		return false;
+	}
+#if !KYTY_FFX
+	(void)buffer;
+	(void)output;
+	return Fail(s, Fallback::NotBuiltIn);
+#else
+	PassInfo pass;
+	if (!output || !ReadPass(s, pixel, pass)) {
+		return Fail(s, Fallback::Bindings);
+	}
+	if (!pass.mv_used) {
+		return Fail(s, Fallback::NoMotionVectors);
+	}
+	const uint32_t in_w = pass.in_w, in_h = pass.in_h, out_w = pass.out_w, out_h = pass.out_h;
+	auto&          cache = m_context.GetTextureCache();
+	ImageId        depth_id {};
+	for (const auto& pair: s.depth_pairs) {
+		if (pair.color == pass.mv) {
+			depth_id = pair.depth;
+		}
+	}
+	if (!depth_id || cache.m_slot_images.try_get(depth_id) == nullptr) {
+		return Fail(s, Fallback::NoDepth);
+	}
+	auto&      mv    = cache.GetImage(pass.mv);
+	auto&      color = cache.GetImage(pass.color);
+	auto&      depth = cache.GetImage(depth_id);
+	auto&      out   = cache.GetImage(output);
+	const auto same  = [](const Image& image, uint32_t w, uint32_t h) {
+        return image.info.extent.width == w && image.info.extent.height == h &&
+               image.backing.image != nullptr && image.info.samples == 1;
+	};
+	if (!same(mv, in_w, in_h) || !same(color, in_w, in_h) || !same(depth, in_w, in_h) ||
+	    !same(out, out_w, out_h) || !depth.info.IsDepth() ||
+	    !(out.backing.usage & vk::ImageUsageFlagBits::eStorage)) {
+		return Fail(s, Fallback::Sizes);
+	}
+	if (!s.fsr_ready) {
+		return Fail(s, Fallback::Unavailable);
+	}
+	auto& graphics = m_context.GetGraphics();
+	buffer.EndRendering();
+	const auto cmd = buffer.Handle();
+	if (s.fsr == nullptr || s.fsr_in_w != in_w || s.fsr_in_h != in_h || s.fsr_out_w != out_w ||
+	    s.fsr_out_h != out_h) {
+		if (s.fsr != nullptr) {
+			graphics.device.waitIdle();
+			ffxDestroyContext(&s.fsr, nullptr);
+			s.fsr = nullptr;
+		}
+		ffxCreateBackendVKDesc backend {};
+		backend.header.type      = FFX_API_CREATE_CONTEXT_DESC_TYPE_BACKEND_VK;
+		backend.vkDevice         = static_cast<VkDevice>(graphics.device);
+		backend.vkPhysicalDevice = static_cast<VkPhysicalDevice>(graphics.physical_device);
+		g_fsr_real_gdpa = reinterpret_cast<PFN_vkGetDeviceProcAddr>(
+		    graphics.instance.getProcAddr("vkGetDeviceProcAddr"));
+		backend.vkDeviceProcAddr = &FsrGetDeviceProcAddr;
+		std::printf("FSR: creating the upscaler (%ux%u -> %ux%u)\n", in_w, in_h, out_w, out_h);
+		std::fflush(stdout);
+		ffxCreateContextDescUpscale create {};
+		create.header.type    = FFX_API_CREATE_CONTEXT_DESC_TYPE_UPSCALE;
+		create.header.pNext   = &backend.header;
+		create.maxRenderSize  = {in_w, in_h};
+		create.maxUpscaleSize = {out_w, out_h};
+		create.flags          = FFX_UPSCALE_ENABLE_HIGH_DYNAMIC_RANGE | FFX_UPSCALE_ENABLE_AUTO_EXPOSURE |
+		               FFX_UPSCALE_ENABLE_MOTION_VECTORS_JITTER_CANCELLATION |
+		               (s.depth_inverted ? static_cast<uint32_t>(FFX_UPSCALE_ENABLE_DEPTH_INVERTED) : 0u);
+		const auto result = ffxCreateContext(&s.fsr, &create.header, nullptr);
+		if (result != FFX_API_RETURN_OK || s.fsr == nullptr) {
+			std::printf("FSR: context creation failed (%u) for %ux%u -> %ux%u\n", static_cast<unsigned>(result),
+			            in_w, in_h, out_w, out_h);
+			std::fflush(stdout);
+			s.fsr       = nullptr;
+			s.fsr_ready = false;
+			return Fail(s, Fallback::CreateFailed);
+		}
+		s.fsr_in_w = in_w, s.fsr_in_h = in_h, s.fsr_out_w = out_w, s.fsr_out_h = out_h;
+		s.feature_in_w = in_w, s.feature_in_h = in_h, s.feature_out_w = out_w, s.feature_out_h = out_h;
+		std::printf("FSR: AMD FSR 3.1 upscaler created, %ux%u -> %ux%u\n", in_w, in_h, out_w, out_h);
+		std::fflush(stdout);
+	}
+
+	mv.Transit(vk::ImageLayout::eShaderReadOnlyOptimal, vk::AccessFlagBits2::eShaderSampledRead, {}, cmd);
+	color.Transit(vk::ImageLayout::eShaderReadOnlyOptimal, vk::AccessFlagBits2::eShaderSampledRead, {}, cmd);
+	depth.Transit(vk::ImageLayout::eShaderReadOnlyOptimal, vk::AccessFlagBits2::eShaderSampledRead, {}, cmd);
+	out.Transit(vk::ImageLayout::eGeneral,
+	            vk::AccessFlagBits2::eShaderStorageRead | vk::AccessFlagBits2::eShaderStorageWrite, {}, cmd);
+	const auto resource = [](const Image& image, uint32_t usage, uint32_t state) {
+		FfxApiResourceDescription desc {};
+		desc.type     = FFX_API_RESOURCE_TYPE_TEXTURE2D;
+		desc.format   = ffxApiGetSurfaceFormatVK(static_cast<VkFormat>(image.backing.format));
+		desc.width    = image.info.extent.width;
+		desc.height   = image.info.extent.height;
+		desc.depth    = 1;
+		desc.mipCount = 1;
+		desc.flags    = FFX_API_RESOURCE_FLAGS_NONE;
+		desc.usage    = usage;
+		return ffxApiGetResourceVK(reinterpret_cast<void*>(static_cast<VkImage>(image.backing.image)), desc, state);
+	};
+	ffxDispatchDescUpscale dispatch {};
+	dispatch.header.type   = FFX_API_DISPATCH_DESC_TYPE_UPSCALE;
+	dispatch.commandList   = reinterpret_cast<void*>(static_cast<VkCommandBuffer>(cmd));
+	dispatch.color         = resource(color, FFX_API_RESOURCE_USAGE_READ_ONLY, FFX_API_RESOURCE_STATE_PIXEL_COMPUTE_READ);
+	dispatch.depth         = resource(depth, FFX_API_RESOURCE_USAGE_DEPTHTARGET, FFX_API_RESOURCE_STATE_PIXEL_COMPUTE_READ);
+	dispatch.motionVectors = resource(mv, FFX_API_RESOURCE_USAGE_READ_ONLY, FFX_API_RESOURCE_STATE_PIXEL_COMPUTE_READ);
+	dispatch.output        = resource(out, FFX_API_RESOURCE_USAGE_UAV, FFX_API_RESOURCE_STATE_UNORDERED_ACCESS);
+	// Same conventions as DLSS: jitter in input pixels, motion vectors in UV from previous to current.
+	dispatch.jitterOffset      = {pass.jitter_px[0], pass.jitter_px[1]};
+	dispatch.motionVectorScale = {-static_cast<float>(in_w), -static_cast<float>(in_h)};
+	dispatch.renderSize        = {in_w, in_h};
+	dispatch.upscaleSize       = {out_w, out_h};
+	dispatch.enableSharpening  = false;
+	dispatch.sharpness         = 0.0f;
+	const auto now             = NowNs();
+	dispatch.frameTimeDelta    = s.fsr_last_ns == 0
+	                                 ? 16.6f
+	                                 : std::clamp(static_cast<float>(now - s.fsr_last_ns) / 1.0e6f, 1.0f, 100.0f);
+	s.fsr_last_ns                    = now;
+	dispatch.preExposure             = 1.0f;
+	dispatch.reset                   = s.last_frame != 0 && pass.frame != s.last_frame + 1;
+	dispatch.cameraNear              = s.camera_near;
+	dispatch.cameraFar               = s.camera_far;
+	dispatch.cameraFovAngleVertical  = s.camera_fov;
+	dispatch.viewSpaceToMetersFactor = 1.0f;
+	s.last_frame                     = pass.frame;
+	s.last_jitter[0]                 = pass.jitter_px[0];
+	s.last_jitter[1]                 = pass.jitter_px[1];
+	const auto result                = ffxDispatch(&s.fsr, &dispatch.header);
+	buffer.ForgetBoundState();
+	if (result != FFX_API_RETURN_OK) {
+		return Fail(s, Fallback::EvaluateFailed);
+	}
+	s.evaluations++;
+	Summary(s);
+	return true;
+#endif
+}
+
 bool RenderExecutor::TryDlssUpscale(CommandBuffer& buffer, PreparedBindings& pixel, ImageId output) {
-	if (!Dlss::Requested() || pixel.runtime == nullptr || !*pixel.runtime) {
