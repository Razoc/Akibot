diff --git a/src/graphics/host_gpu/renderer/fsrFrameGen.cpp b/src/graphics/host_gpu/renderer/fsrFrameGen.cpp
new file mode 100644
index 00000000..98b32bd9
--- /dev/null
+++ b/src/graphics/host_gpu/renderer/fsrFrameGen.cpp
@@ -0,0 +1,354 @@
+#include "graphics/host_gpu/renderer/fsrFrameGen.h"
+
+#include "graphics/host_gpu/renderer/frameGen.h"
+
+#if KYTY_FFX
+#include <ffx_api/ffx_api.h>
+#include <ffx_api/ffx_framegeneration.h>
+#include <ffx_api/vk/ffx_api_vk.h>
+#endif
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+
+namespace Libs::Graphics::FsrFrameGen {
+
+bool Requested() {
+#if KYTY_FFX
+	static const bool requested = [] {
+		const char* value = std::getenv("AKIBOT_FSRFG");
+		const bool  on    = value != nullptr && std::strcmp(value, "1") == 0;
+		if (on && FrameGen::Requested()) {
+			std::printf("FSR-FG: not used, NVIDIA frame generation (AKIBOT_DLSSG) is on\n");
+			std::fflush(stdout);
+			return false;
+		}
+		return on;
+	}();
+	return requested;
+#else
+	return false;
+#endif
+}
+
+uint32_t ExtraQueues() {
+	return Requested() ? 3u : 0u;
+}
+
+#if !KYTY_FFX
+
+bool Active() {
+	return false;
+}
+bool CreateSwapchain(PFN_vkGetDeviceProcAddr, VkPhysicalDevice, VkDevice, const Queues&, VkSwapchainCreateInfoKHR,
+                     VkSwapchainKHR*) {
+	return false;
+}
+void     DestroySwapchain(VkDevice, VkSwapchainKHR) {}
+VkResult GetSwapchainImages(VkDevice, VkSwapchainKHR, uint32_t*, VkImage*) {
+	return VK_ERROR_INITIALIZATION_FAILED;
+}
+VkResult AcquireNextImage(VkDevice, VkSwapchainKHR, uint64_t, VkSemaphore, VkFence, uint32_t*) {
+	return VK_ERROR_INITIALIZATION_FAILED;
+}
+VkResult QueuePresent(VkQueue, const VkPresentInfoKHR*) {
+	return VK_ERROR_INITIALIZATION_FAILED;
+}
+void Prepare(VkCommandBuffer, const Image&, const Image&, const float*, const float*, float, float, float) {}
+
+#else
+
+namespace {
+
+struct State {
+	std::mutex                                  mutex;
+	std::atomic<bool>                           active {false};
+	ffxContext                                  swapchain_context = nullptr;
+	ffxContext                                  fg_context        = nullptr;
+	ffxQueryDescSwapchainReplacementFunctionsVK functions {};
+	VkSwapchainKHR                              swapchain = VK_NULL_HANDLE;
+	uint32_t                                    width = 0, height = 0;
+	uint64_t                                    frame_id    = 0;
+	int64_t                                     last_ns     = 0;
+	int64_t                                     print_ns    = 0;
+	uint64_t                                    prepares    = 0;
+	uint64_t                                    failures    = 0;
+	uint64_t                                    last_count  = 0;
+};
+
+State& Get() {
+	static State state;
+	return state;
+}
+
+int64_t NowNs() {
+	return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch())
+	    .count();
+}
+
+// AMD's runtime asks for some core functions by their old extension names and calls them unchecked.
+PFN_vkGetDeviceProcAddr g_real_gdpa = nullptr;
+PFN_vkVoidFunction VKAPI_PTR DeviceProcAddr(VkDevice device, const char* name) {
+	auto fn = g_real_gdpa != nullptr ? g_real_gdpa(device, name) : nullptr;
+	if (fn == nullptr && g_real_gdpa != nullptr) {
+		const size_t length = std::strlen(name);
+		if (length > 3 && std::strcmp(name + length - 3, "KHR") == 0) {
+			const std::string core(name, length - 3);
+			fn = g_real_gdpa(device, core.c_str());
+		}
+	}
+	return fn;
+}
+
+// AMD's messages (errors and warnings) to the console.
+void Message(uint32_t type, const wchar_t* message) {
+	std::printf("FSR-FG message %u: %ls\n", type, message != nullptr ? message : L"");
+	std::fflush(stdout);
+}
+
+ffxReturnCode_t Generate(ffxDispatchDescFrameGeneration* params, void* context) {
+	return ffxDispatch(static_cast<ffxContext*>(context), &params->header);
+}
+
+FfxApiResource Resource(const Image& image) {
+	FfxApiResourceDescription desc {};
+	desc.type     = FFX_API_RESOURCE_TYPE_TEXTURE2D;
+	desc.format   = ffxApiGetSurfaceFormatVK(image.format);
+	desc.width    = image.width;
+	desc.height   = image.height;
+	desc.depth    = 1;
+	desc.mipCount = 1;
+	desc.flags    = FFX_API_RESOURCE_FLAGS_NONE;
+	desc.usage    = image.depth ? FFX_API_RESOURCE_USAGE_DEPTHTARGET : FFX_API_RESOURCE_USAGE_READ_ONLY;
+	return ffxApiGetResourceVK(reinterpret_cast<void*>(image.image), desc, FFX_API_RESOURCE_STATE_PIXEL_COMPUTE_READ);
+}
+
+void DestroyLocked(State& s) {
+	s.active.store(false, std::memory_order_release);
+	if (s.fg_context != nullptr) {
+		ffxDestroyContext(&s.fg_context, nullptr);
+		s.fg_context = nullptr;
+	}
+	if (s.swapchain_context != nullptr) {
+		ffxDestroyContext(&s.swapchain_context, nullptr); // destroys the swapchain too
+		s.swapchain_context = nullptr;
+	}
+	s.swapchain = VK_NULL_HANDLE;
+}
+
+} // namespace
+
+bool Active() {
+	return Get().active.load(std::memory_order_acquire);
+}
+
+bool CreateSwapchain(PFN_vkGetDeviceProcAddr device_proc_addr, VkPhysicalDevice physical, VkDevice device,
+                     const Queues& queues, VkSwapchainCreateInfoKHR info, VkSwapchainKHR* swapchain) {
+	auto&            s = Get();
+	std::scoped_lock lock(s.mutex);
+	DestroyLocked(s);
+	if (queues.present == VK_NULL_HANDLE || queues.image_acquire == VK_NULL_HANDLE || queues.compute == VK_NULL_HANDLE) {
+		std::printf("FSR-FG: the device has no spare queues, frame generation off\n");
+		std::fflush(stdout);
+		return false;
+	}
+	g_real_gdpa = device_proc_addr;
+	info.pNext  = nullptr;
+	// Diagnostic (AKIBOT_FSRFG_PROBE=1): which swapchain variants Vulkan accepts on this surface.
+	if (const char* probe = std::getenv("AKIBOT_FSRFG_PROBE"); probe != nullptr && probe[0] == '1') {
+		auto create_fn  = reinterpret_cast<PFN_vkCreateSwapchainKHR>(device_proc_addr(device, "vkCreateSwapchainKHR"));
+		auto destroy_fn = reinterpret_cast<PFN_vkDestroySwapchainKHR>(device_proc_addr(device, "vkDestroySwapchainKHR"));
+		const auto try_info = [&](const char* what, VkSwapchainCreateInfoKHR variant) {
+			VkSwapchainKHR test   = VK_NULL_HANDLE;
+			const auto     result = create_fn(device, &variant, nullptr, &test);
+			std::printf("FSR-FG probe %s: %d (images %u, usage 0x%x, mode %d, format %d)\n", what,
+			            static_cast<int>(result), variant.minImageCount, variant.imageUsage,
+			            static_cast<int>(variant.presentMode), static_cast<int>(variant.imageFormat));
+			std::fflush(stdout);
+			if (test != VK_NULL_HANDLE) {
+				destroy_fn(device, test, nullptr);
+			}
+		};
+		try_info("as is", info);
+		auto more = info;
+		more.minImageCount += 2;
+		try_info("+2 images", more);
+		auto usage = info;
+		usage.imageUsage |= VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+		try_info("+usages", usage);
+		auto fifo = info;
+		fifo.presentMode = VK_PRESENT_MODE_FIFO_KHR;
+		try_info("fifo", fifo);
+	}
+
+	VkSwapchainKHR                               handle = VK_NULL_HANDLE;
+	ffxCreateContextDescFrameGenerationSwapChainVK create {};
+	create.header.type       = FFX_API_CREATE_CONTEXT_DESC_TYPE_FGSWAPCHAIN_VK;
+	create.physicalDevice    = physical;
+	create.device            = device;
+	create.swapchain         = &handle;
+	create.allocator         = nullptr;
+	create.createInfo        = info;
+	create.gameQueue         = {queues.game, queues.family, nullptr};
+	create.asyncComputeQueue = {queues.compute, queues.family, nullptr};
+	create.presentQueue      = {queues.present, queues.family, nullptr};
+	create.imageAcquireQueue = {queues.image_acquire, queues.family, nullptr};
+	ffxConfigureDescGlobalDebug1 debug {};
+	debug.header.type = FFX_API_CONFIGURE_DESC_TYPE_GLOBALDEBUG1;
+	debug.fpMessage   = &Message;
+	debug.debugLevel  = FFX_API_CONFIGURE_GLOBALDEBUG_LEVEL_WARNINGS;
+	create.header.pNext = &debug.header;
+	auto result              = ffxCreateContext(&s.swapchain_context, &create.header, nullptr);
+	if (result != FFX_API_RETURN_OK || handle == VK_NULL_HANDLE) {
+		std::printf("FSR-FG: swapchain creation failed (%u)\n", static_cast<unsigned>(result));
+		std::fflush(stdout);
+		s.swapchain_context = nullptr;
+		return false;
+	}
+	s.functions             = {};
+	s.functions.header.type = FFX_API_QUERY_DESC_TYPE_FGSWAPCHAIN_FUNCTIONS_VK;
+	result                  = ffxQuery(&s.swapchain_context, &s.functions.header);
+	if (result != FFX_API_RETURN_OK || s.functions.pOutQueuePresentKHR == nullptr ||
+	    s.functions.pOutAcquireNextImageKHR == nullptr || s.functions.pOutGetSwapchainImagesKHR == nullptr) {
+		std::printf("FSR-FG: swapchain functions unavailable (%u)\n", static_cast<unsigned>(result));
+		std::fflush(stdout);
+		DestroyLocked(s);
+		return false;
+	}
+
+	ffxCreateBackendVKDesc backend {};
+	backend.header.type      = FFX_API_CREATE_CONTEXT_DESC_TYPE_BACKEND_VK;
+	backend.vkDevice         = device;
+	backend.vkPhysicalDevice = physical;
+	backend.vkDeviceProcAddr = &DeviceProcAddr;
+	ffxCreateContextDescFrameGeneration fg {};
+	fg.header.type      = FFX_API_CREATE_CONTEXT_DESC_TYPE_FRAMEGENERATION;
+	fg.header.pNext     = &backend.header;
+	fg.flags            = FFX_FRAMEGENERATION_ENABLE_MOTION_VECTORS_JITTER_CANCELLATION;
+	fg.displaySize      = {info.imageExtent.width, info.imageExtent.height};
+	fg.maxRenderSize    = {std::max(info.imageExtent.width, 3840u), std::max(info.imageExtent.height, 2160u)};
+	fg.backBufferFormat = ffxApiGetSurfaceFormatVK(info.imageFormat);
+	result              = ffxCreateContext(&s.fg_context, &fg.header, nullptr);
+	if (result != FFX_API_RETURN_OK || s.fg_context == nullptr) {
+		std::printf("FSR-FG: frame generation context failed (%u)\n", static_cast<unsigned>(result));
+		std::fflush(stdout);
+		s.fg_context = nullptr;
+		DestroyLocked(s);
+		return false;
+	}
+	s.swapchain = handle;
+	s.width     = info.imageExtent.width;
+	s.height    = info.imageExtent.height;
+	s.frame_id  = 0;
+	s.last_ns   = 0;
+	*swapchain  = handle;
+	s.active.store(true, std::memory_order_release);
+	std::printf("FSR-FG: AMD frame interpolation swapchain %ux%u, frame generation on\n", s.width, s.height);
+	std::fflush(stdout);
+	return true;
+}
+
+void DestroySwapchain(VkDevice device, VkSwapchainKHR swapchain) {
+	(void)device;
+	(void)swapchain;
+	auto&            s = Get();
+	std::scoped_lock lock(s.mutex);
+	DestroyLocked(s);
+}
+
+VkResult GetSwapchainImages(VkDevice device, VkSwapchainKHR swapchain, uint32_t* count, VkImage* images) {
+	return Get().functions.pOutGetSwapchainImagesKHR(device, swapchain, count, images);
+}
+
+VkResult AcquireNextImage(VkDevice device, VkSwapchainKHR swapchain, uint64_t timeout, VkSemaphore semaphore,
+                          VkFence fence, uint32_t* index) {
+	return Get().functions.pOutAcquireNextImageKHR(device, swapchain, timeout, semaphore, fence, index);
+}
+
+VkResult QueuePresent(VkQueue queue, const VkPresentInfoKHR* info) {
+	auto&            s       = Get();
+	VkPresentInfoKHR present = *info;
+	present.pNext            = nullptr; // no present ID / low-latency chains through AMD's swapchain
+	const auto result        = s.functions.pOutQueuePresentKHR(queue, &present);
+	const auto now           = NowNs();
+	if (s.print_ns == 0) {
+		s.print_ns = now;
+	} else if (now - s.print_ns >= 10'000'000'000LL) {
+		const uint64_t count = s.functions.pOutGetLastPresentCountFFXAPI != nullptr
+		                           ? s.functions.pOutGetLastPresentCountFFXAPI(s.swapchain)
+		                           : 0;
+		std::printf("FSR-FG 10s: %llu frames shown, %llu prepared (%llu failed)\n",
+		            static_cast<unsigned long long>(count - s.last_count),
+		            static_cast<unsigned long long>(s.prepares), static_cast<unsigned long long>(s.failures));
+		std::fflush(stdout);
+		s.last_count = count;
+		s.prepares   = 0;
+		s.failures   = 0;
+		s.print_ns   = now;
+	}
+	return result;
+}
+
+void Prepare(VkCommandBuffer cmd, const Image& depth, const Image& motion, const float jitter_px[2],
+             const float mv_scale[2], float near_plane, float far_plane, float fov) {
+	auto&            s = Get();
+	std::scoped_lock lock(s.mutex);
+	if (!s.active.load(std::memory_order_acquire) || s.fg_context == nullptr) {
+		return;
+	}
+	s.frame_id++;
+	ffxConfigureDescFrameGeneration config {};
+	config.header.type                        = FFX_API_CONFIGURE_DESC_TYPE_FRAMEGENERATION;
+	config.swapChain                          = reinterpret_cast<void*>(s.swapchain);
+	config.presentCallback                    = nullptr;
+	config.presentCallbackUserContext         = nullptr;
+	config.frameGenerationCallback            = &Generate;
+	config.frameGenerationCallbackUserContext = &s.fg_context;
+	config.frameGenerationEnabled             = true;
+	config.allowAsyncWorkloads                = false;
+	config.HUDLessColor                       = {};
+	config.flags                              = 0;
+	config.onlyPresentGenerated               = false;
+	config.generationRect = {0, 0, static_cast<int32_t>(s.width), static_cast<int32_t>(s.height)};
+	config.frameID        = s.frame_id;
+	auto result           = ffxConfigure(&s.fg_context, &config.header);
+	if (result != FFX_API_RETURN_OK) {
+		s.failures++;
+		return;
+	}
+	const auto now = NowNs();
+	ffxDispatchDescFrameGenerationPrepare prepare {};
+	prepare.header.type             = FFX_API_DISPATCH_DESC_TYPE_FRAMEGENERATION_PREPARE;
+	prepare.frameID                 = s.frame_id;
+	prepare.flags                   = 0;
+	prepare.commandList             = reinterpret_cast<void*>(cmd);
+	prepare.renderSize              = {motion.width, motion.height};
+	prepare.jitterOffset            = {jitter_px[0], jitter_px[1]};
+	prepare.motionVectorScale       = {mv_scale[0], mv_scale[1]};
+	prepare.frameTimeDelta          = s.last_ns == 0 ? 16.6f
+	                                                 : std::clamp(static_cast<float>(now - s.last_ns) / 1.0e6f, 1.0f, 100.0f);
+	s.last_ns                       = now;
+	prepare.unused_reset            = false;
+	prepare.cameraNear              = near_plane;
+	prepare.cameraFar               = far_plane;
+	prepare.cameraFovAngleVertical  = fov;
+	prepare.viewSpaceToMetersFactor = 1.0f;
+	prepare.depth                   = Resource(depth);
+	prepare.motionVectors           = Resource(motion);
+	result                          = ffxDispatch(&s.fg_context, &prepare.header);
+	if (result != FFX_API_RETURN_OK) {
+		s.failures++;
+		return;
+	}
+	s.prepares++;
+}
+
+#endif
+
+} // namespace Libs::Graphics::FsrFrameGen
