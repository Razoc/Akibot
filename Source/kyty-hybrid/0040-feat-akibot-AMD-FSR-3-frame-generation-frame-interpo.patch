+#ifndef EMULATOR_SRC_GRAPHICS_HOST_GPU_RENDERER_FSRFRAMEGEN_H_
+#define EMULATOR_SRC_GRAPHICS_HOST_GPU_RENDERER_FSRFRAMEGEN_H_
+
+#include <cstdint>
+
+#include <vulkan/vulkan.h>
+
+// AkiBot: AKIBOT_FSRFG=1 (default off; build with KYTY_FFX_SDK_DIR, amd_fidelityfx_vk.dll next to
+// the game): AMD FSR 3.1 frame generation. AMD's frame interpolation swapchain replaces the window's
+// swapchain (create, images, acquire, present, destroy); at the game's temporal upscale pass (dlss.cpp)
+// the frame's depth, motion vectors and camera are handed to it, and it presents one generated frame
+// between two rendered ones. Not together with NVIDIA frame generation (AKIBOT_DLSSG wins).
+// The swapchain needs three more queues of the graphics family (present, image acquire, async compute), asked for at
+// device creation (ExtraQueues). One "FSR-FG 10s:" console line every 10 s.
+namespace Libs::Graphics::FsrFrameGen {
