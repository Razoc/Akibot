+constexpr std::array<int, 7>         FPS_VALUES {30, 35, 45, 50, 55, 60, 0};
+constexpr std::array<int, 6>         SPEED_PERCENT {100, 95, 90, 85, 80, 75};
+constexpr std::array<int, 8>         RUMBLE_PERCENT {0, 5, 10, 20, 40, 70, 100, 150};
+constexpr std::array<const char*, 3> PRIORITIES {"normal", "abovenormal", "high"};
+
+// ----------------------------------------------------------------------------------------------
+// State
+
+std::atomic<bool>     g_open {false};
+std::atomic<uint64_t> g_generation {0};
+std::atomic<int>      g_fullscreen_request {-1}; // -1 none, 0 windowed, 1 fullscreen
+std::atomic<Uint32>   g_wakeup_event {0};
+
+std::mutex            g_mutex; // the fields below
+Json                  g_settings;
+std::vector<int>      g_values; // per option: Choice index, or Toggle 0/1
+std::vector<int>      g_initial;
+Tab                   g_tab        = Tab::Graphics;
+bool                  g_focus_top  = false;
+std::string           g_save_error;
+
+const char* SettingsPath() {
+	static const char* path = std::getenv("AKIBOT_SETTINGS_FILE");
+	return path != nullptr && path[0] != '\0' ? path : nullptr;
+}
+
+int ReadIndex(const Option& option, const Json& json) {
+	const auto it = json.find(option.key);
+	if (option.kind == Kind::Toggle) {
+		return it != json.end() && it->is_boolean() ? (it->get<bool>() ? 1 : 0) : (option.defaults_on ? 1 : 0);
+	}
+	if (it == json.end()) {
+		return option.default_index;
+	}
+	const int count = static_cast<int>(option.choices.size());
+	if (std::strcmp(option.key, "priority") == 0 && it->is_string()) {
+		const auto value = it->get<std::string>();
+		for (int i = 0; i < 3; ++i) {
+			if (value == PRIORITIES[i]) {
+				return i;
+			}
+		}
+		return option.default_index;
+	}
+	if (!it->is_number_integer()) {
+		return option.default_index;
+	}
+	int value = it->get<int>();
+	if (std::strcmp(option.key, "language") == 0) {
+		value = value < 0 || value > 30 ? 0 : value + 1;
+	} else if (std::strcmp(option.key, "cpPriority") == 0) {
+		value = value <= 1 ? 0 : 1;
+	} else if (std::strcmp(option.key, "rumblepct") == 0) {
+		if (value < 0) {
+			return option.default_index;
+		}
+		int best = 0;
+		for (int i = 0; i < static_cast<int>(RUMBLE_PERCENT.size()); ++i) {
+			if (std::abs(RUMBLE_PERCENT[i] - value) < std::abs(RUMBLE_PERCENT[best] - value)) {
+				best = i;
+			}
+		}
+		return best;
+	}
+	return std::clamp(value, 0, count - 1);
+}
+
+void WriteIndex(const Option& option, int index, Json& json) {
+	if (option.kind == Kind::Toggle) {
+		json[option.key] = index != 0;
+	} else if (std::strcmp(option.key, "priority") == 0) {
+		json[option.key] = PRIORITIES[index];
+	} else if (std::strcmp(option.key, "language") == 0) {
+		json[option.key] = index == 0 ? -1 : index - 1;
+	} else if (std::strcmp(option.key, "cpPriority") == 0) {
+		json[option.key] = index + 1;
+	} else if (std::strcmp(option.key, "rumblepct") == 0) {
+		json[option.key] = RUMBLE_PERCENT[index];
+	} else {
+		json[option.key] = index;
+	}
+}
+
+void Load() {
+	g_settings = Json::object();
+	if (const char* path = SettingsPath(); path != nullptr) {
+		std::ifstream file(std::filesystem::u8path(path));
+		if (file) {
+			g_settings = Json::parse(file, nullptr, false);
+			if (g_settings.is_discarded() || !g_settings.is_object()) {
+				g_settings = Json::object();
+			}
+		}
+	}
+	const auto& options = Options();
+	g_values.resize(options.size());
+	for (size_t i = 0; i < options.size(); ++i) {
+		g_values[i] = ReadIndex(options[i], g_settings);
+	}
+	if (g_initial.empty()) {
+		g_initial = g_values; // what the game was started with
+	}
+}
+
+void Save() {
+	const char* path = SettingsPath();
+	if (path == nullptr) {
+		return;
+	}
+	const auto& options = Options();
+	for (size_t i = 0; i < options.size(); ++i) {
+		WriteIndex(options[i], g_values[i], g_settings);
+	}
+	const auto target = std::filesystem::u8path(path);
+	auto       temp   = target;
+	temp += ".tmp";
+	{
+		std::ofstream file(temp, std::ios::binary | std::ios::trunc);
+		if (!file) {
+			g_save_error = "write";
+			return;
+		}
+		file << g_settings.dump(2);
+	}
+	std::error_code error;
+	std::filesystem::rename(temp, target, error);
+	g_save_error = error ? "rename" : "";
+}
+
+int ValueOf(const char* key) {
+	const auto& options = Options();
+	for (size_t i = 0; i < options.size(); ++i) {
+		if (std::strcmp(options[i].key, key) == 0) {
+			return g_values[i];
+		}
+	}
+	return 0;
+}
+
+bool FrameGenOn() {
+	return ValueOf("fgmode") != 0;
+}
+
+void ApplyLive(const Option& option, int index) {
+	switch (option.live) {
+		case Live::FrameLimit:
+			if (!FrameGenOn()) {
+				VideoOut::SetFrameLimit(static_cast<uint32_t>(FPS_VALUES[index]));
+			}
+			break;
+		case Live::Overlay: SetPerformanceOverlayMode(index); break;
+		case Live::Speed: VideoOut::SetGameSpeedPercent(SPEED_PERCENT[index]); break;
+		case Live::Fullscreen: {
+			g_fullscreen_request.store(index, std::memory_order_release);
+			SDL_Event event {};
+			event.type = g_wakeup_event.load(std::memory_order_acquire);
+			if (event.type != 0) {
+				(void)SDL_PushEvent(&event);
+			}
+			break;
+		}
+		case Live::No: break;
+	}
+}
+
+bool OptionEnabled(const Option& option) {
+	if (std::strcmp(option.key, "fps") == 0) {
+		return !FrameGenOn();
+	}
+	if (std::strcmp(option.key, "fgtarget") == 0) {
+		return FrameGenOn();
+	}
+	return true;
+}
+
+// ----------------------------------------------------------------------------------------------
+// Drawing
+
+ImVec4 Rgb(int r, int g, int b, float a = 1.0f) {
+	return {static_cast<float>(r) / 255.0f, static_cast<float>(g) / 255.0f, static_cast<float>(b) / 255.0f, a};
+}
+
+const ImU32 COLOR_TEXT    = IM_COL32(244, 242, 255, 255);
+const ImU32 COLOR_MUTED   = IM_COL32(125, 116, 163, 255);
+const ImU32 COLOR_VALUE   = IM_COL32(182, 174, 214, 255);
+const ImU32 COLOR_ACCENT  = IM_COL32(124, 92, 255, 255);
+const ImU32 COLOR_ORANGE  = IM_COL32(255, 159, 67, 255);
+const ImU32 COLOR_ROW     = IM_COL32(23, 19, 42, 255);
+const ImU32 COLOR_ROW_HOT = IM_COL32(38, 30, 72, 255);
+
+// One option row: label on the left, value on the right. Returns -1/+1 to step a choice (Left/Right,
+// clicks on the arrows, A/Enter or a click on the row = +1).
+int Row(const Option& option, int value, bool enabled, float width, float height, float scale) {
+	ImGui::PushID(option.key);
+	ImGui::BeginDisabled(!enabled);
+	const ImVec2 start = ImGui::GetCursorScreenPos();
+	const bool   clicked = ImGui::InvisibleButton("##row", {width, height}, ImGuiButtonFlags_EnableNav);
+	const bool   focused = ImGui::IsItemFocused();
+	const bool   hovered = ImGui::IsItemHovered();
+	ImGui::EndDisabled();
+
+	auto* draw = ImGui::GetWindowDrawList();
+	const ImVec2 end {start.x + width, start.y + height};
+	draw->AddRectFilled(start, end, focused || hovered ? COLOR_ROW_HOT : COLOR_ROW, 10.0f * scale);
+	if (focused) {
+		draw->AddRect(start, end, COLOR_ACCENT, 10.0f * scale, 0, 2.0f * scale);
+	}
+	const float alpha = enabled ? 1.0f : 0.4f;
+	const auto  fade  = [alpha](ImU32 color) {
+        return (color & 0x00FFFFFFu) | (static_cast<ImU32>(((color >> 24) & 0xFF) * alpha) << 24);
+	};
+	const float text_y = start.y + (height - ImGui::GetFontSize()) * 0.5f;
+	draw->AddText({start.x + 18.0f * scale, text_y}, fade(COLOR_TEXT), T(option.label));
+	if (option.live == Live::No) {
+		const float label_w = ImGui::CalcTextSize(T(option.label)).x;
+		draw->AddText({start.x + 18.0f * scale + label_w + 6.0f * scale, text_y}, fade(COLOR_ORANGE), "*");
+	}
+
+	int step = 0;
+	if (option.kind == Kind::Toggle) {
+		const float tw = 44.0f * scale;
+		const float th = 24.0f * scale;
+		const ImVec2 t0 {end.x - 18.0f * scale - tw, start.y + (height - th) * 0.5f};
+		const ImVec2 t1 {t0.x + tw, t0.y + th};
+		const bool   on = value != 0;
+		draw->AddRectFilled(t0, t1, fade(on ? COLOR_ACCENT : IM_COL32(33, 27, 58, 255)), th * 0.5f);
+		if (!on) {
+			draw->AddRect(t0, t1, fade(COLOR_MUTED), th * 0.5f, 0, 1.0f * scale);
+		}
+		const float r = (on ? 8.0f : 7.0f) * scale;
+		const float cx = on ? t1.x - 4.0f * scale - r : t0.x + 5.0f * scale + r;
+		draw->AddCircleFilled({cx, (t0.y + t1.y) * 0.5f}, r, fade(on ? IM_COL32_WHITE : COLOR_VALUE));
+		if (enabled && (clicked || (focused && (ImGui::IsKeyPressed(ImGuiKey_GamepadDpadLeft) ||
+		                                        ImGui::IsKeyPressed(ImGuiKey_GamepadDpadRight))))) {
+			step = 1;
+		}
+	} else {
+		const char* text  = T(option.choices[static_cast<size_t>(value)]);
+		const float tw    = ImGui::CalcTextSize(text).x;
+		const float arrow = 22.0f * scale;
+		const float right = end.x - 18.0f * scale;
+		const float left  = right - arrow * 2.0f - std::max(tw, 120.0f * scale) - 12.0f * scale;
+		draw->AddText({left, text_y}, fade(focused ? COLOR_ACCENT : COLOR_MUTED), "<");
+		draw->AddText({right - ImGui::CalcTextSize(">").x, text_y}, fade(focused ? COLOR_ACCENT : COLOR_MUTED), ">");
+		const float mid = (left + arrow + right - arrow) * 0.5f;
+		draw->AddText({mid - tw * 0.5f, text_y}, fade(COLOR_VALUE), text);
+		if (enabled) {
+			if (focused && ImGui::IsKeyPressed(ImGuiKey_GamepadDpadLeft)) {
+				step = -1;
+			} else if (focused && ImGui::IsKeyPressed(ImGuiKey_GamepadDpadRight)) {
+				step = 1;
+			} else if (clicked) {
+				step = ImGui::GetIO().MousePos.x < left + arrow * 1.5f ? -1 : 1;
+			}
+		}
+	}
+	ImGui::PopID();
+	return step;
+}
+
+bool Button(const char* label, float width, float height, bool primary) {
+	ImGui::PushStyleColor(ImGuiCol_Button, primary ? Rgb(124, 92, 255) : Rgb(33, 27, 58));
+	ImGui::PushStyleColor(ImGuiCol_ButtonHovered, primary ? Rgb(148, 121, 255) : Rgb(44, 37, 72));
+	ImGui::PushStyleColor(ImGuiCol_ButtonActive, primary ? Rgb(100, 70, 230) : Rgb(44, 37, 72));
+	const bool pressed = ImGui::Button(label, {width, height});
+	ImGui::PopStyleColor(3);
+	return pressed;
+}
