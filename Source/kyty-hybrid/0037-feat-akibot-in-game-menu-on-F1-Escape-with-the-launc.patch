+} // namespace
+
+bool Available() noexcept {
+	return SettingsPath() != nullptr;
+}
+
+bool IsOpen() noexcept {
+	return g_open.load(std::memory_order_acquire);
+}
+
+uint64_t Generation() noexcept {
+	return g_generation.load(std::memory_order_acquire);
+}
+
+void Toggle() {
+	if (IsOpen()) {
+		Close();
+		return;
+	}
+	{
+		std::scoped_lock lock(g_mutex);
+		if (const char* lang = std::getenv("AKIBOT_LANG"); lang != nullptr) {
+			g_french = std::strcmp(lang, "fr") == 0;
+		}
+		if (g_wakeup_event.load(std::memory_order_acquire) == 0) {
+			const Uint32 type = SDL_RegisterEvents(1);
+			g_wakeup_event.store(type == static_cast<Uint32>(-1) ? 0 : type, std::memory_order_release);
+		}
+		Load();
+		g_focus_top = true;
+	}
+	g_generation.fetch_add(1, std::memory_order_acq_rel);
+	g_open.store(true, std::memory_order_release);
+	RefreshSystemOverlayVisibility();
+}
+
+void Close() {
+	if (!g_open.exchange(false, std::memory_order_acq_rel)) {
+		return;
+	}
+	RefreshSystemOverlayVisibility();
+}
+
+bool ProcessWindowRequests(uint32_t event_type) {
+	const int want = g_fullscreen_request.exchange(-1, std::memory_order_acq_rel);
+	if (want >= 0) {
+		if (SDL_Window* window = SDL_GetKeyboardFocus(); window != nullptr) {
+			const bool fullscreen = (SDL_GetWindowFlags(window) & SDL_WINDOW_FULLSCREEN) != 0u;
+			if (fullscreen != (want != 0)) {
+				(void)SDL_SetWindowFullscreen(window, want != 0);
+			}
+		}
+	}
+	const Uint32 wakeup = g_wakeup_event.load(std::memory_order_acquire);
+	return wakeup != 0 && event_type == wakeup;
+}
+
+void Draw(float width, float height) {
+	if (!IsOpen()) {
+		return;
+	}
+	std::scoped_lock lock(g_mutex);
+	const auto& options = Options();
+	const float scale   = std::clamp(height / 1080.0f, 0.75f, 2.0f);
+	const float win_w   = std::min(900.0f * scale, width - 40.0f);
+	const float win_h   = std::min(820.0f * scale, height - 40.0f);
+	const float pad     = 28.0f * scale;
+	const float row_h   = 44.0f * scale;
+	const float gap     = 6.0f * scale;
+
+	// Dim the game behind the menu.
+	ImGui::GetBackgroundDrawList()->AddRectFilled({0, 0}, {width, height}, IM_COL32(8, 6, 16, 150));
+
+	if (g_focus_top) {
+		ImGui::SetNextWindowFocus();
+	}
+	ImGui::SetNextWindowPos({(width - win_w) * 0.5f, (height - win_h) * 0.5f});
+	ImGui::SetNextWindowSize({win_w, win_h});
+	ImGui::PushStyleVar(ImGuiStyleVar_WindowRounding, 18.0f * scale);
+	ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, {pad, pad});
+	ImGui::PushStyleVar(ImGuiStyleVar_ItemSpacing, {gap, gap});
+	ImGui::PushStyleVar(ImGuiStyleVar_FrameRounding, 10.0f * scale);
+	ImGui::PushStyleVar(ImGuiStyleVar_WindowBorderSize, 1.0f);
+	ImGui::PushStyleColor(ImGuiCol_WindowBg, Rgb(14, 11, 26, 0.97f));
+	ImGui::PushStyleColor(ImGuiCol_Border, Rgb(44, 37, 72));
+	ImGui::PushStyleColor(ImGuiCol_Text, Rgb(244, 242, 255));
+	ImGui::PushStyleColor(ImGuiCol_NavHighlight, Rgb(124, 92, 255));
+	ImGui::PushStyleColor(ImGuiCol_ScrollbarBg, Rgb(14, 11, 26, 0.0f));
+	ImGui::PushStyleColor(ImGuiCol_ScrollbarGrab, Rgb(44, 37, 72));
+	ImGui::PushFont(nullptr, 17.0f * scale);
+	ImGui::Begin("##akibot_menu", nullptr,
+	             ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoSavedSettings |
+	                 ImGuiWindowFlags_NoScrollbar | ImGuiWindowFlags_NoScrollWithMouse);
+
+	// Header
+	ImGui::PushFont(nullptr, 28.0f * scale);
+	ImGui::TextUnformatted("AkiBot");
+	ImGui::PopFont();
+	ImGui::SameLine();
+	ImGui::SetCursorPosX(win_w - pad - ImGui::CalcTextSize(g_french ? "F1 / Échap pour fermer" : "F1 / Esc to close").x);
+	ImGui::SetCursorPosY(ImGui::GetCursorPosY() + 8.0f * scale);
+	ImGui::TextColored(Rgb(125, 116, 163), "%s", g_french ? "F1 / Échap pour fermer" : "F1 / Esc to close");
+	ImGui::Dummy({0, 6.0f * scale});
+
+	// Tabs (LB / RB, PageUp / PageDown, or a click)
+	const std::array<Text, 3> tabs {{{"Graphismes", "Graphics"}, {"Manette", "Controller"}, {"Avancé", "Advanced"}}};
+	if (ImGui::IsKeyPressed(ImGuiKey_F13, false)) {
+		g_tab       = static_cast<Tab>((static_cast<int>(g_tab) + 2) % 3);
+		g_focus_top = true;
+	} else if (ImGui::IsKeyPressed(ImGuiKey_F14, false)) {
+		g_tab       = static_cast<Tab>((static_cast<int>(g_tab) + 1) % 3);
+		g_focus_top = true;
+	}
+	const float tab_w = (win_w - pad * 2.0f - gap * 2.0f) / 3.0f;
+	for (int i = 0; i < 3; ++i) {
+		if (i > 0) {
+			ImGui::SameLine();
+		}
+		const bool current = static_cast<int>(g_tab) == i;
+		ImGui::PushStyleColor(ImGuiCol_Button, current ? Rgb(124, 92, 255, 0.25f) : Rgb(23, 19, 42));
+		ImGui::PushStyleColor(ImGuiCol_ButtonHovered, Rgb(124, 92, 255, 0.35f));
+		ImGui::PushStyleColor(ImGuiCol_ButtonActive, Rgb(124, 92, 255, 0.45f));
+		ImGui::PushStyleColor(ImGuiCol_Text, current ? Rgb(244, 242, 255) : Rgb(182, 174, 214));
+		ImGui::PushItemFlag(ImGuiItemFlags_NoNav, true);
+		if (ImGui::Button(T(tabs[static_cast<size_t>(i)]), {tab_w, 40.0f * scale})) {
+			g_tab       = static_cast<Tab>(i);
+			g_focus_top = true;
+		}
+		ImGui::PopItemFlag();
+		ImGui::PopStyleColor(4);
+	}
+	ImGui::Dummy({0, 4.0f * scale});
+
+	// Rows
+	const float footer_h = 46.0f * scale + 34.0f * scale;
+	// Rows straight in the window (no child: keyboard/controller navigation stays row by row).
+	const float rows_bottom = ImGui::GetCursorPosY() + ImGui::GetContentRegionAvail().y - footer_h;
+	const float row_w       = ImGui::GetContentRegionAvail().x;
+	bool        first = true;
+	for (size_t i = 0; i < options.size(); ++i) {
+		const auto& option = options[i];
+		if (option.tab != g_tab) {
+			continue;
+		}
+		const bool enabled = OptionEnabled(option);
+		const int  step    = Row(option, g_values[i], enabled, row_w, row_h, scale);
+		if (first && g_focus_top && enabled) {
+			// Start on the tab's first row (keyboard and controller navigation).
+			ImGui::SetItemDefaultFocus();
+			ImGui::SetKeyboardFocusHere(-1);
+			g_focus_top = false;
+		}
+		first = first && !enabled;
+		if (step != 0) {
+			if (option.kind == Kind::Toggle) {
+				g_values[i] = g_values[i] != 0 ? 0 : 1;
+			} else {
+				const int count = static_cast<int>(option.choices.size());
+				g_values[i]     = (g_values[i] + step + count) % count;
+			}
+			Save();
+			ApplyLive(option, g_values[i]);
+		}
+	}
+	ImGui::SetCursorPosY(std::max(ImGui::GetCursorPosY(), rows_bottom));
+
+	// Footer: note on restart-only options, then Resume / Quit
+	bool pending = false;
+	for (size_t i = 0; i < options.size(); ++i) {
+		pending = pending || (options[i].live == Live::No && g_values[i] != g_initial[i]);
+	}
+	ImGui::TextColored(pending ? Rgb(255, 159, 67) : Rgb(125, 116, 163), "%s",
+	                   pending ? (g_french ? "* Modifié : s'appliquera au prochain lancement du jeu."
+	                                       : "* Changed: applies the next time the game starts.")
+	                           : (g_french ? "* s'applique au prochain lancement du jeu"
+	                                       : "* applies the next time the game starts"));
+	if (!g_save_error.empty()) {
+		ImGui::SameLine();
+		ImGui::TextColored(Rgb(255, 92, 122), "%s", g_french ? "(enregistrement impossible)" : "(could not save)");
+	}
+	const float button_w = 200.0f * scale;
+	ImGui::SetCursorPosX(win_w - pad - button_w * 2.0f - gap);
+	bool close = Button(g_french ? "Quitter le jeu" : "Quit game", button_w, 42.0f * scale, false);
+	if (close) {
+		SDL_Event event {};
+		event.type = SDL_EVENT_QUIT;
+		(void)SDL_PushEvent(&event);
+	}
+	ImGui::SameLine();
+	if (Button(g_french ? "Reprendre" : "Resume", button_w, 42.0f * scale, true)) {
+		close = true;
+	}
+	if (ImGui::IsKeyPressed(ImGuiKey_GamepadFaceRight) || ImGui::IsKeyPressed(ImGuiKey_F15, false)) {
+		close = true; // B / Circle, or Start / Options
+	}
+
+	ImGui::End();
+	ImGui::PopFont();
+	ImGui::PopStyleColor(6);
+	ImGui::PopStyleVar(5);
+
+	if (close) {
+		g_open.store(false, std::memory_order_release);
+		RefreshSystemOverlayVisibility();
+	}
+}
+
+} // namespace Libs::Graphics::AkiBotMenu
