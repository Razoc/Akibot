+#ifndef EMULATOR_SRC_GRAPHICS_PRESENTATION_AKIBOTMENU_H_
+#define EMULATOR_SRC_GRAPHICS_PRESENTATION_AKIBOTMENU_H_
+
+#include <cstdint>
+
+// AkiBot in-game menu (F1 or Escape): every option of the AkiBot launcher. The options the engine can
+// change while the game runs (frame-rate limit, FPS counter, fullscreen, game speed) apply at once; the
+// others are saved to the launcher's settings file (AKIBOT_SETTINGS_FILE, Build\akibot-settings.json)
+// and apply on the next start. While the menu is open the game gets no controller, keyboard or mouse
+// input (the system overlay captures them). Texts: AKIBOT_LANG=fr|en (default en).
+namespace Libs::Graphics::AkiBotMenu {
+
+[[nodiscard]] bool     Available() noexcept; // a settings file was given
+[[nodiscard]] bool     IsOpen() noexcept;
+[[nodiscard]] uint64_t Generation() noexcept; // changes every time the menu opens
+void                   Toggle();
+void                   Close();
+
+// Window thread: applies a pending fullscreen change (returns true when the event was the menu's wakeup).
+bool ProcessWindowRequests(uint32_t event_type);
+
+// Render thread, inside the system overlay's ImGui frame.
+void Draw(float width, float height);
+
+} // namespace Libs::Graphics::AkiBotMenu
+
+#endif // EMULATOR_SRC_GRAPHICS_PRESENTATION_AKIBOTMENU_H_
