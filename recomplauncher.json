{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "AkiBot",
  "repo": "Razoc/AkiBot",
  "start": {
    "program": ["AkiBot.exe"],
    "args": ["--play"]
  },
  "config": [
    {
      "id": "main",
      "format": "json",
      "file": [{ "path": "{install}/Build/akibot-settings.json" }]
    }
  ],
  "saves": [
    "{install}/Build/RunHybrid/_sd",
    "{install}/Build/RunHybrid/_sd_mem",
    "{install}/Build/RunHybrid/_trophy",
    "{install}/Build/akibot-settings.json"
  ],
  "folders": {
    "saves": [{ "path": "{install}/Build/RunHybrid/_sd_mem" }],
    "logs": [{ "path": "{install}/Logs" }],
    "game": [{ "path": "{install}/Build/RunHybrid" }]
  },
  "looks": {
    "allowed": false,
    "reason": "The game runs in a second program (Build\\RunHybrid\\AstroBot.exe) started by AkiBot, so ReShade looks don't reach it."
  },
  "settings": [
    {
      "id": "upscale", "label": "Upscaling", "group": "Picture",
      "help": "DLSS needs an NVIDIA RTX card. FSR works on any card.",
      "choices": [
        { "label": "Game's own", "set": { "upscale": "0" } },
        { "label": "DLSS Quality", "set": { "upscale": "1" } },
        { "label": "DLSS Balanced", "set": { "upscale": "2" } },
        { "label": "DLSS Performance", "set": { "upscale": "3" } },
        { "label": "DLSS Ultra Performance", "set": { "upscale": "4" } },
        { "label": "DLAA", "set": { "upscale": "5" } },
        { "label": "AMD FSR 3.1", "set": { "upscale": "6" } }
      ],
      "defaults": { "upscale": "0" }
    },
    {
      "id": "framegen", "label": "Frame generation", "group": "Picture",
      "help": "Adds frames between the game's own. NVIDIA needs an RTX 40 or 50 card. AMD FSR 3 works on any card.",
      "choices": [
        { "label": "Off", "set": { "fgmode": "0" } },
        { "label": "NVIDIA auto", "set": { "fgmode": "1" } },
        { "label": "NVIDIA 2x", "set": { "fgmode": "2" } },
        { "label": "NVIDIA 3x", "set": { "fgmode": "3" } },
        { "label": "NVIDIA 4x", "set": { "fgmode": "4" } },
        { "label": "AMD FSR 3 2x", "set": { "fgmode": "5" } }
      ],
      "defaults": { "fgmode": "0" }
    },
    {
      "id": "fgtarget", "label": "On-screen target", "group": "Picture",
      "help": "The frame rate aimed for with frame generation. The game is capped at this target divided by the multiplier.",
      "choices": [
        { "label": "No limit", "set": { "fgtarget": "0" } },
        { "label": "50 FPS", "set": { "fgtarget": "1" } },
        { "label": "60 FPS", "set": { "fgtarget": "2" } },
        { "label": "90 FPS", "set": { "fgtarget": "3" } },
        { "label": "120 FPS", "set": { "fgtarget": "4" } },
        { "label": "144 FPS", "set": { "fgtarget": "5" } },
        { "label": "165 FPS", "set": { "fgtarget": "6" } }
      ],
      "defaults": { "fgtarget": "2" }
    },
    {
      "id": "fps", "label": "Frame rate limit", "group": "Picture",
      "help": "Without frame generation. 30 is the steadiest; the game runs at real speed at every limit.",
      "choices": [
        { "label": "30", "set": { "fps": "0" } },
        { "label": "35", "set": { "fps": "1" } },
        { "label": "45", "set": { "fps": "2" } },
        { "label": "50", "set": { "fps": "3" } },
        { "label": "55", "set": { "fps": "4" } },
        { "label": "60", "set": { "fps": "5" } },
        { "label": "No limit", "set": { "fps": "6" } }
      ],
      "defaults": { "fps": "0" },
      "when": { "fgmode": "0" }
    },
    {
      "id": "vsync", "label": "V-Sync", "group": "Picture",
      "help": "Removes tearing, without frame generation.",
      "choices": [
        { "label": "Off", "set": { "vsync": "false" } },
        { "label": "On", "set": { "vsync": "true" } }
      ],
      "defaults": { "vsync": "false" },
      "when": { "fgmode": "0" }
    },
    {
      "id": "window", "label": "Window", "group": "Display",
      "help": "Fullscreen or windowed. In Big Picture mode the game always opens fullscreen.",
      "choices": [
        { "label": "Fullscreen", "set": { "fullscreen": "true" } },
        { "label": "Windowed", "set": { "fullscreen": "false" } }
      ],
      "defaults": { "fullscreen": "true" }
    },
    {
      "id": "size", "label": "Resolution", "group": "Display",
      "help": "The size of the game's picture.",
      "choices": [
        { "label": "1280 x 720", "set": { "size": "0" } },
        { "label": "1600 x 900", "set": { "size": "1" } },
        { "label": "1920 x 1080", "set": { "size": "2" } },
        { "label": "2560 x 1440", "set": { "size": "3" } },
        { "label": "2560 x 1080 (21:9)", "set": { "size": "4" } },
        { "label": "3440 x 1440 (21:9)", "set": { "size": "5" } }
      ],
      "defaults": { "size": "2" }
    },
    {
      "id": "overlay", "label": "FPS counter", "group": "Display",
      "help": "The frame rate in the top right corner of the game, generated frames included.",
      "choices": [
        { "label": "Off", "set": { "overlay": "0" } },
        { "label": "On", "set": { "overlay": "1" } }
      ],
      "defaults": { "overlay": "0" }
    }
  ],
  "actions": [
    { "id": "logs", "label": "Logs", "help": "AkiBot's and the game's logs, to attach to a bug report.", "open": "logs" },
    { "id": "saves", "label": "Saves", "help": "Your Astro Bot progress.", "open": "saves" },
    { "id": "cache", "label": "Shader cache", "help": "Shaders already built, for less stutter. Only clear it if the picture looks wrong after an update.", "clear": "game/_PipelineCache" }
  ]
}
